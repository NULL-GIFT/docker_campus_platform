<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus_platform.mapper.NoticeMapper">

    <resultMap id="NoticeMap" type="com.campus_platform.entity.Notice">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="publisherId" column="publisher_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.campus_platform.entity.Notice" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notice (title, content, publisher_id, create_time, update_time)
        VALUES (#{title}, #{content}, #{publisherId}, NOW(), NOW())
    </insert>

    <select id="findAll" resultMap="NoticeMap">
        SELECT * FROM notice ORDER BY create_time DESC
    </select>

    <select id="selectById" resultMap="NoticeMap">
        SELECT * FROM notice WHERE id = #{id}
    </select>

</mapper>